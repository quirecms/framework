# The site's production settings and secrets, for Docker Compose. Copy this file to prod.env (which
# Git and the Docker image never include), fill it in, and start the site with:
#
#     docker compose --env-file prod.env up --wait
#
# See https://github.com/quirecms/framework/blob/main/docs/docker.md#production

# The production setup: compose.yaml and compose.prod.yaml together
COMPOSE_FILE=compose.yaml:compose.prod.yaml

# The site's domain. Its DNS must point at this server: Caddy then obtains its certificate.
SERVER_NAME=example.com

# Secrets: long random values, e.g. from "openssl rand -hex 32". Keep them: changing APP_SECRET signs
# everyone out, and POSTGRES_PASSWORD is the database's password from its first start on.
APP_SECRET=
POSTGRES_PASSWORD=

# Where emails go (password resets, invitations), e.g. smtp://user:pass@smtp.example.com:587.
# Write characters such as @ in the user or password as %40 and so on. Empty: no email is sent.
MAILER_DSN=
