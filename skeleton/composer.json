{
    "name": "quire/skeleton",
    "type": "project",
    "license": "MIT",
    "description": "A new Quire site: the Quire CMS core, its default theme and the admin interface, ready to run with Docker.",
    "keywords": [
        "quire",
        "cms",
        "skeleton"
    ],
    "homepage": "https://quirecms.com",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": "@application",
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "replace": "@application",
    "scripts": {
        "auto-scripts": "@application",
        "post-create-project-cmd": [
            "@php -r \"file_put_contents('.env.dev', str_replace('APP_SECRET=', 'APP_SECRET='.bin2hex(random_bytes(16)), file_get_contents('.env.dev')));\""
        ],
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": "@application",
    "extra": "@application"
}
