{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:quire.localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
	}

	root /app/public
	encode zstd br gzip

	# Security headers on every response. "?" sets one only when the response has none, so Quire's own
	# stricter ones win (e.g. private pages can't be framed at all). HSTS tells browsers to use HTTPS for
	# a year; development sets QUIRE_HSTS_MAX_AGE=0. See docs/docker.md, "Security headers".
	header {
		?Strict-Transport-Security "max-age={$QUIRE_HSTS_MAX_AGE:31536000}"
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "SAMEORIGIN"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		?Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Compiled assets have a version in their file name, so browsers can keep them for good. (The JSON
	# files next to them are AssetMapper's own lists, which change.)
	@compiledAssets {
		path /assets/*
		not path *.json
		file
	}
	header @compiledAssets Cache-Control "public, max-age=31536000, immutable"

	# Files of local public storage disks (storage/public/<disk>): named after their content, so they
	# never change. Uploads are someone's content: never sniffed into another type, and never able to
	# run scripts as the site. Without a file, the request goes on to Quire, which says 404.
	# See https://github.com/quirecms/framework/blob/main/docs/storage.md
	@storedFile {
		path_regexp ^/storage/[a-z][a-z0-9_-]*/[0-9a-f]{2}/[0-9a-f]{2}/[0-9a-f]{64}\.[a-z0-9]+$
		file {
			root /app/storage/public
			try_files /{http.request.uri.path.1}/{http.request.uri.path.2}/{http.request.uri.path.3}/{http.request.uri.path.4}
		}
	}
	handle @storedFile {
		rewrite * /{http.request.uri.path.1}/{http.request.uri.path.2}/{http.request.uri.path.3}/{http.request.uri.path.4}
		root * /app/storage/public
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		header Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; media-src 'self'; sandbox"
		file_server
	}

	@phpRoute {
		not file {path}
		not {
			path_regexp ^/storage/[a-z][a-z0-9_-]*/[0-9a-f]{2}/[0-9a-f]{2}/[0-9a-f]{64}\.[a-z0-9]+$
			file {
				root /app/storage/public
				try_files /{http.request.uri.path.1}/{http.request.uri.path.2}/{http.request.uri.path.3}/{http.request.uri.path.4}
			}
		}
	}
	rewrite @phpRoute index.php

	@frontController path index.php
	php @frontController {
		{$FRANKENPHP_SITE_CONFIG}

		worker {
			file ./public/index.php
			{$FRANKENPHP_WORKER_CONFIG}
		}
	}

	file_server {
		hide *.php
	}
}
