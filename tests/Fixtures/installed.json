{
    "packages": [
        {
            "name": "quire/admin",
            "version": "0.1.0.0",
            "pretty_version": "0.1.0",
            "type": "quire-extension",
            "install-path": "../../packages/admin",
            "description": "Quire's administration panel",
            "extra": {
                "quire": {
                    "title": "Admin",
                    "description": "Manage content, settings, extensions, themes and users in the browser.",
                    "importmap": {
                        "@codemirror/autocomplete": "6.20.3",
                        "@codemirror/commands": "6.11.1",
                        "@codemirror/lang-css": "6.3.1",
                        "@codemirror/lang-html": "6.4.12",
                        "@codemirror/lang-javascript": "6.2.5",
                        "@codemirror/lang-markdown": "6.5.2",
                        "@codemirror/language": "6.13.1",
                        "@codemirror/state": "6.7.6",
                        "@codemirror/streamparser": "6.0.0",
                        "@codemirror/view": "6.43.15",
                        "@hotwired/stimulus": "3.2.2",
                        "@hotwired/turbo": "8.0.23",
                        "@lezer/common": "1.5.2",
                        "@lezer/css": "1.1.9",
                        "@lezer/highlight": "1.2.5",
                        "@lezer/html": "1.3.13",
                        "@lezer/javascript": "1.5.4",
                        "@lezer/lr": "1.4.5",
                        "@lezer/markdown": "1.7.2",
                        "@marijn/find-cluster-break": "1.0.4",
                        "crelt": "1.0.7",
                        "open-props/borders.min.css": "1.7.23",
                        "open-props/easings.min.css": "1.7.23",
                        "open-props/sizes.min.css": "1.7.23",
                        "style-mod": "4.1.4",
                        "w3c-keyname": "2.2.8"
                    }
                }
            }
        },
        {
            "name": "quire/fixture-hello",
            "version": "1.0.0.0",
            "pretty_version": "1.0.0",
            "type": "quire-extension",
            "install-path": "extensions/hello",
            "description": "Test extension that exercises every extender",
            "extra": {
                "quire": {
                    "id": "quire-fixture-hello"
                }
            }
        },
        {
            "name": "quire/fixture-recipes",
            "version": "1.0.0.0",
            "pretty_version": "1.0.0",
            "type": "quire-extension",
            "install-path": "extensions/recipes",
            "description": "Test extension with a field type, a content type and a setting, and no admin code",
            "extra": {
                "quire": {
                    "id": "quire-fixture-recipes",
                    "title": "Recipes"
                }
            }
        },
        {
            "name": "quire/fixture-theme-base",
            "version": "1.0.0.0",
            "pretty_version": "1.0.0",
            "type": "quire-theme",
            "install-path": "themes/base",
            "description": "Test theme with a layout and a content template",
            "extra": {
                "quire": {
                    "id": "quire-fixture-base"
                }
            }
        },
        {
            "name": "quire/fixture-theme-child",
            "version": "1.0.0.0",
            "pretty_version": "1.0.0",
            "type": "quire-theme",
            "install-path": "themes/child",
            "description": "Test theme that inherits from the base test theme",
            "extra": {
                "quire": {
                    "id": "quire-fixture-child",
                    "requires": [
                        "quire-fixture-hello"
                    ],
                    "theme": {
                        "parent": "quire-fixture-base"
                    }
                }
            }
        },
        {
            "name": "quire/fixture-theme-orphan",
            "version": "1.0.0.0",
            "pretty_version": "1.0.0",
            "type": "quire-theme",
            "install-path": "themes/orphan",
            "description": "Test theme whose parent isn't installed",
            "extra": {
                "quire": {
                    "id": "quire-fixture-orphan",
                    "theme": {
                        "parent": "quire-fixture-gone"
                    }
                }
            }
        },
        {
            "name": "quire/fixture-theme-broken",
            "version": "1.0.0.0",
            "pretty_version": "1.0.0",
            "type": "quire-theme",
            "install-path": "themes/broken",
            "description": "Test theme with mistakes for quire:theme:lint",
            "extra": {
                "quire": {
                    "id": "quire-fixture-broken"
                }
            }
        },
        {
            "name": "quire/theme-default",
            "version": "dev-main",
            "pretty_version": "dev-main",
            "type": "quire-theme",
            "install-path": "../../packages/theme-default",
            "extra": {
                "quire": {
                    "title": "Default"
                }
            }
        },
        {
            "name": "quire/fixture-theme-default-child",
            "version": "1.0.0.0",
            "pretty_version": "1.0.0",
            "type": "quire-theme",
            "install-path": "themes/default-child",
            "description": "Test theme that overrides one template of the default theme",
            "extra": {
                "quire": {
                    "id": "quire-fixture-default-child",
                    "theme": {
                        "parent": "quire-theme-default"
                    }
                }
            }
        }
    ],
    "dev": true,
    "dev-package-names": []
}
