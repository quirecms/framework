<!doctype html>
<html lang="{{ site.locale }}">
<head>
    <title>{% block title %}{{ site.title }}{% endblock %}</title>
    {{ quire_seo() }}
    <meta name="description" content="{{ site.description }}">
    <link rel="canonical" href="{{ canonical_url|default('') }}">
    <meta name="robots" content="noindex">
    {{ quire_slot('head') }}
</head>
<body>
    {{ quire_slot('body_start') }}
    <header>{{ quire_slot('header.nav') }}</header>
    <main>{% block content %}{% endblock %}</main>
    {{ quire_slot('sidebar') }}
    <footer>{{ quire_slot('footer') }}{% if quire_slot_filled('error404.suggestions') %}{{ quire_slot('error404.suggestions', {path: app.request.pathInfo}) }}{% endif %}</footer>
    {{ quire_slot('body_end') }}
</body>
</html>
