<!doctype html>
<html lang="{{ site.locale }}">
<head>
    <title>{% block title %}{{ site.title }}{% endblock %}</title>
    {% block head %}{% endblock %}
    {{ quire_slot('head') }}
</head>
<body class="theme-base{{ fixture_base_extend_ran is defined ? ' base-extend-ran' }}{{ fixture_child_extend_ran is defined ? ' child-extend-ran' }}" data-accent="{{ theme.settings.accent }}" data-dates="{{ theme.settings.show_dates ? 'yes' : 'no' }}">
    {{ quire_slot('body_start') }}
    <header>{{ quire_slot('header.nav') }}</header>
    <main>{% block content %}{% endblock %}</main>
    {{ quire_slot('sidebar') }}
    <footer>{{ quire_slot('footer') }}</footer>
    {{ quire_slot('body_end') }}
</body>
</html>
