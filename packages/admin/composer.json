{
    "name": "quire/admin",
    "type": "quire-extension",
    "description": "Quire's administration panel: manage content, settings, extensions, themes and users in the browser.",
    "keywords": ["quire", "cms", "admin"],
    "homepage": "https://quirecms.com",
    "license": "MIT",
    "authors": [
        {
            "name": "YorvoLabs",
            "homepage": "https://quirecms.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "quire/core": "^0.1"
    },
    "require-dev": {
        "quire/testing": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Quire\\Admin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Quire\\Admin\\Tests\\": "tests/"
        }
    },
    "extra": {
        "quire": {
            "title": "Admin",
            "description": "Manage content, settings, extensions, themes and users in the browser.",
            "importmap": {
                "@hotwired/stimulus": "3.2.2",
                "@hotwired/turbo": "8.0.23"
            }
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
