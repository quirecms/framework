{#
    The admin's page layout (Quire UI). Pages extend it and fill "title" and "content"; "eyebrow" goes
    above the heading, "actions" next to it.

    The menu's sections are the rail (at the bottom on phones); a section's entries are tabs above its
    pages. Everything works without JavaScript: the "New" and account menus are <details>.
#}
{% import '@quire_admin/_ui.html.twig' as ui %}
{% set menu = quire_admin_menu() %}
{% set hood = quire_admin_hood() %}
{% set icons = {general: 'home', content: 'content', users: 'people', activity: 'activity', site: 'site', extensions: 'more'} %}
{% set current_section = null %}
{% for section, items in menu %}
    {% for item in items %}{% if item.current %}{% set current_section = section %}{% endif %}{% endfor %}
{% endfor %}
<!doctype html>
{% set preferences = quire_admin_preferences() %}
<html lang="{{ app.request.locale }}"{% if hood %} data-hood="on"{% endif %}{% for name, value in preferences.attributes %} {{ name }}="{{ value }}"{% endfor %}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="color-scheme" content="light dark">
    {#- Turbo drives the admin's pages only: the site's are full page loads, with their theme's stylesheets
        and scripts, which Turbo would otherwise merge into the admin's <head> and keep there. #}
    <meta name="turbo-root" content="{{ path('quire_admin_dashboard') }}">
    <title>{% block title %}{% endblock %} · {{ 'Admin'|trans({}, 'quire-admin') }} · {{ site.title }}</title>
    {{ quire_slot('admin.head') }}
</head>
{# Keyboard shortcuts, and opening the preferences (see admin.js). #}
{% set creatable = quire_admin_new() %}
{% set content_url = (menu.content ?? [])|first.url ?? null %}
<body class="q-admin" data-controller="shortcuts" data-action="keydown@window->shortcuts#key"
      data-shortcuts-urls-value="{{ {home: path('quire_admin_dashboard'), content: content_url, people: is_granted('quire.users.manage') ? path('quire_admin_users') : null, new: (creatable|first).url ?? null}|json_encode }}">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <symbol id="q-icon-home" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11l8-7 8 7v9H4z"/><path d="M10 20v-5h4v5"/></symbol>
        <symbol id="q-icon-content" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h10"/></symbol>
        <symbol id="q-icon-people" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="9" cy="8" r="3.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17.5" cy="9" r="2.5"/><path d="M17 14c2.5 0 4 1.8 4 4.5"/></symbol>
        <symbol id="q-icon-activity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3-7 4 14 3-7h4"/></symbol>
        <symbol id="q-icon-site" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 9h18M8 21h8"/></symbol>
        <symbol id="q-icon-more" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3h4v4a2 2 0 1 0 0 4v4h-4a2 2 0 1 0-4 0H3v-4a2 2 0 1 0 0-4V3h4a2 2 0 1 0 3 0z"/></symbol>
    </svg>
    <a class="q-skip" href="#main">{{ 'Skip to content'|trans({}, 'quire-admin') }}</a>

    <div class="q-shell">
        <nav class="q-rail" aria-label="{{ 'Admin menu'|trans({}, 'quire-admin') }}">
            <a class="q-rail__brand" href="{{ path('quire_admin_dashboard') }}" title="{{ 'Admin'|trans({}, 'quire-admin') }}">{{ ui.logo() }}<span class="q-sr">{{ 'Admin'|trans({}, 'quire-admin') }}</span></a>

            {% if creatable is not empty %}
                <details class="q-menu">
                    <summary class="q-new"><b aria-hidden="true">＋</b>{{ 'New'|trans({}, 'quire-admin') }}</summary>
                    <ul class="q-menu__panel q-menu__panel--side">
                        <li class="q-menu__label">{{ 'Create'|trans({}, 'quire-admin') }}</li>
                        {% for entry in creatable %}<li><a href="{{ entry.url }}">{{ entry.label }}</a></li>{% endfor %}
                    </ul>
                </details>
            {% endif %}

            <ul class="q-rail__nav">
                {% for section, items in menu %}
                    <li>
                        <a class="q-rail__item" href="{{ items|first.url }}"{% if section == current_section %} aria-current="page"{% endif %}>
                            {#- Alone in "More", an extension's page is named after itself. -#}
                            {{ ui.icon(icons[section] ?? 'more') }}                            {{ section == 'extensions' and items|length == 1 ? (items|first).label : ('section.' ~ section)|trans({}, 'quire-admin') }}
                            {%- if section == 'general' -%}
                                {%- set waiting = quire_admin_inbox_count() -%}
                                {%- if waiting > 0 %}<span class="q-rail__badge"><span aria-hidden="true">{{ waiting }}</span><span class="q-sr">, {{ '{count, plural, =0 {nothing waits for you} one {# thing waits for you} other {# things wait for you}}'|trans({count: waiting}, 'quire-admin') }}</span></span>{% endif -%}
                            {%- endif %}
                        </a>
                    </li>
                {% endfor %}
            </ul>
            <span class="q-rail__spacer"></span>
        </nav>

        <div class="q-canvas">
            <header class="q-topbar">
                <div class="q-topbar__site"><span class="q-live-dot" aria-hidden="true"></span>{{ site.title }} <a href="{{ path('quire_home') }}">{{ 'view site'|trans({}, 'quire-admin') }} ↗</a></div>
                {# The intent bar: a search form without JavaScript; with it, a dialog (Ctrl/⌘+K) that understands as you type. #}
                <div class="q-intent" data-controller="intent" data-intent-url-value="{{ path('quire_admin_find') }}" data-action="keydown@window->intent#shortcut">
                <form class="q-intent-trigger" method="get" action="{{ path('quire_admin_find') }}" role="search">
                    <label for="intent-q" class="q-sr">{{ 'Find anything, or say what to do'|trans({}, 'quire-admin') }}</label>
                    <input type="search" id="intent-q" name="q" autocomplete="off" placeholder="{{ 'Find anything, or say what to do'|trans({}, 'quire-admin') }}" data-action="focus->intent#open click->intent#open">
                    <kbd class="q-intent-trigger__keys" aria-hidden="true">Ctrl K</kbd>
                </form>
                    <dialog class="intent-dialog" aria-label="{{ 'Find or do'|trans({}, 'quire-admin') }}" data-intent-target="dialog" data-action="close->intent#closed">
                        <div class="intent-dialog__bar">
                            <label for="intent-dialog-q" class="q-sr">{{ 'Find anything, or say what to do'|trans({}, 'quire-admin') }}</label>
                            <input type="search" id="intent-dialog-q" autocomplete="off" spellcheck="false" placeholder="{{ 'Find anything, or say what to do'|trans({}, 'quire-admin') }}" data-intent-target="input" data-action="input->intent#search keydown->intent#key">
                        </div>
                        <div class="intent-dialog__body" data-intent-target="body" aria-live="polite">{{ include('@quire_admin/intent/_results.html.twig', {q: '', intent: null, found: []}) }}</div>
                        <p class="intent-dialog__keys" aria-hidden="true"><kbd>↵</kbd> {{ 'do it or open'|trans({}, 'quire-admin') }} <kbd>↑</kbd><kbd>↓</kbd> {{ 'choose'|trans({}, 'quire-admin') }} <kbd>esc</kbd> {{ 'close'|trans({}, 'quire-admin') }} <span>{{ 'Understands what the admin can do, in your words'|trans({}, 'quire-admin') }}</span></p>
                    </dialog>
                </div>
                <div class="q-topbar__end">
                    <form method="post" action="{{ path('quire_admin_hood') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('quire_admin_preferences') }}">
                        <input type="hidden" name="back" value="{{ app.request.requestUri }}">
                        <button class="q-switch" aria-pressed="{{ hood ? 'true' : 'false' }}" title="{{ 'Show the commands behind actions, IDs and keyboard hints'|trans({}, 'quire-admin') }}">
                            <span class="q-switch__label">{{ 'Under the hood'|trans({}, 'quire-admin') }}</span><span class="q-switch__track" aria-hidden="true"></span>
                        </button>
                    </form>
                    {% if app.user %}
                        <details class="q-menu q-account">
                            <summary aria-label="{{ 'Account'|trans({}, 'quire-admin') }}"><span class="q-avatar">{{ (app.user.displayName ?? app.user.userIdentifier)|split(' ')|map(word => word|first)|slice(0, 2)|join|upper }}</span></summary>
                            <ul class="q-menu__panel q-menu__panel--end">
                                <li class="q-menu__label">{{ app.user.displayName ?? app.user.userIdentifier }}</li>
                                <li><a href="{{ path('quire_admin_preferences') }}" data-action="shortcuts#preferences">{{ 'Your preferences'|trans({}, 'quire-admin') }}</a></li>
                                {% if hood %}<li><a href="{{ path('quire_admin_ui') }}">{{ 'Components'|trans({}, 'quire-admin') }}</a></li>{% endif %}
                                <li><a href="{{ logout_path() }}" data-turbo="false">{{ 'Sign out'|trans({}, 'quire-admin') }}</a></li>
                            </ul>
                        </details>
                    {% endif %}
                </div>
            </header>

            <main class="q-main" id="main" tabindex="-1">
                {% for type, messages in app.flashes %}
                    {% if type == 'command' %}
                        {# What was just done, as console commands (see AsCommandListener). #}
                        {% include '@quire_admin/_command.html.twig' with {commands: messages} only %}
                    {% else %}
                        {% for message in messages %}
                            <p class="q-notice q-notice--{{ type }}" role="{{ type == 'error' ? 'alert' : 'status' }}">{{ message }}</p>
                        {% endfor %}
                    {% endif %}
                {% endfor %}

                {% block page_head %}
                <div class="q-page-head">
                    <div>
                        {% set eyebrow %}{% block eyebrow %}{{ current_section and current_section != 'general' ? ('section.' ~ current_section)|trans({}, 'quire-admin') : '' }}{% endblock %}{% endset %}
                        {% if eyebrow|trim %}<div class="q-page-head__eyebrow">{{ eyebrow }}</div>{% endif %}
                        <h1>{% block heading %}{{ block('title') }}{% endblock %}</h1>
                    </div>
                    {% block actions %}{% endblock %}
                </div>

                {% if current_section and menu[current_section]|length > 1 %}
                    <nav class="q-tabs" aria-label="{{ ('section.' ~ current_section)|trans({}, 'quire-admin') }}">
                        <ul>
                            {% for item in menu[current_section] %}
                                <li><a href="{{ item.url }}"{% if item.current %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
                            {% endfor %}
                        </ul>
                    </nav>
                {% endif %}

                {% endblock %}

                {% block content %}{% endblock %}
            </main>
        </div>
    </div>

    {% if app.user and app.request.attributes.get('_route') != 'quire_admin_preferences' %}
        <dialog class="prefs-dialog" id="preferences" aria-labelledby="preferences-title" data-controller="preferences" data-shortcuts-target="preferences">
            <header class="prefs-dialog__head">
                <h2 id="preferences-title">{{ 'Your preferences'|trans({}, 'quire-admin') }}</h2>
                <p class="q-meta">{{ 'Only for you, on every device'|trans({}, 'quire-admin') }}</p>
                <form method="dialog"><button class="q-btn q-btn--ghost q-btn--sm" aria-label="{{ 'Close'|trans({}, 'quire-admin') }}">✕</button></form>
            </header>
            {{ include('@quire_admin/_preferences.html.twig') }}
        </dialog>
    {% endif %}
</body>
</html>
