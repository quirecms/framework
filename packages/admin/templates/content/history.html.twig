{#
    An item's revisions, newest first, each with what it changed. Restoring one makes it the item again:
    right away for drafts, and as the user's changes, to publish, for published items.
    Variables: type, item, entries (revision, diff, current), names, changes, timezone.
#}
{% extends '@quire_admin/layout.html.twig' %}

{% block title %}{{ 'History of “{title}”'|trans({title: item.title}, 'quire-admin') }}{% endblock %}

{% block actions %}
    <p class="q-page-head__links">
        <a href="{{ path('quire_admin_content_edit', {type: type.id, id: item.id}) }}">{{ 'Back to the item'|trans({}, 'quire-admin') }}</a>
        {% if is_granted('quire.audit.view') %}<a href="{{ path('quire_admin_audit', {subject_type: 'content', subject: item.id}) }}">{{ 'Activity'|trans({}, 'quire-admin') }}</a>{% endif %}
    </p>
{% endblock %}

{% block content %}
    {% if entries is empty %}
        <p class="q-empty">{{ 'The item has no saved versions yet.'|trans({}, 'quire-admin') }}</p>
    {% endif %}

    <ol class="history">
        {% for entry in entries %}
            {% set revision = entry.revision %}
            <li class="q-card" id="revision-{{ revision.id }}">
                <h2 class="q-card__title">
                    <time datetime="{{ revision.createdAt|date('c') }}">{{ revision.createdAt|date('Y-m-d H:i', timezone) }}</time>
                    {% if entry.current %}<span class="q-meta">({{ 'current'|trans({}, 'quire-admin') }})</span>{% endif %}
                </h2>
                <p class="q-meta">
                    {{ revision.authorId ? names[revision.authorId] : 'Someone'|trans({}, 'quire-admin') }}
                    {% if revision.approvedBy %} · {{ 'approved by {name}'|trans({name: names[revision.approvedBy]}, 'quire-admin') }}{% endif %}
                    {% if revision.message %} · {{ revision.message }}{% endif %}
                </p>
                {% if entry.diff %}
                    <details>
                        <summary>{{ 'What it changed'|trans({}, 'quire-admin') }}</summary>
                        {{ include('@quire_admin/content/_diff.html.twig', {diff: entry.diff, caption: 'What it changed'|trans({}, 'quire-admin')}) }}
                    </details>
                {% endif %}
                {% if not entry.current and not item.deletedAt %}
                    <form method="post" action="{{ path('quire_admin_content_restore', {type: type.id, id: item.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('quire_admin_content_editor') }}">
                        <input type="hidden" name="revision" value="{{ revision.id }}">
                        <button type="submit" class="q-btn q-btn--ghost">
                            {{ changes ? 'Restore as your changes'|trans({}, 'quire-admin') : 'Restore this version'|trans({}, 'quire-admin') }}<span class="q-sr"> ({{ revision.createdAt|date('Y-m-d H:i', timezone) }})</span>
                        </button>
                    </form>
                {% endif %}
            </li>
        {% endfor %}
    </ol>
{% endblock %}
