{#
    The list of a content type's items: views by status, search and filters (a GET form), then one form
    for the actions, with a checkbox per row for the selected items and a button per row action.
    Variables: type, can_create, views, state, filters, columns, rows, page, trash, bulk_actions, previous_url, next_url,
    action_url,
    state_query.
#}
{% extends '@quire_admin/layout.html.twig' %}

{% set plural = type.pluralLabel|trans({}, type.owner) %}

{% block title %}{{ plural }}{% endblock %}

{% block actions %}
    {% if can_create %}
        <a class="button" href="{{ path('quire_admin_content_new', {type: type.id}) }}">{{ 'New'|trans({}, 'quire-admin') }}<span class="visually-hidden"> ({{ type.label|trans({}, type.owner) }})</span></a>
    {% endif %}
{% endblock %}

{% block content %}
    <nav class="views" aria-label="{{ 'Views'|trans({}, 'quire-admin') }}">
        <ul>
            {% for view in views %}
                {% if view.count > 0 or view.current or view.id == 'all' %}
                    <li>
                        <a href="{{ view.url }}"{% if view.current %} aria-current="page"{% endif %}>
                            {{ view.label }} <span class="views__count">{{ view.count }}</span>
                        </a>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
    </nav>

    <form class="list-tools" role="search" method="get" action="{{ path('quire_admin_content', {type: type.id}) }}">
        {% if state.view != 'all' %}<input type="hidden" name="view" value="{{ state.view }}">{% endif %}
        {% if state.sort %}<input type="hidden" name="sort" value="{{ state.sort }}">{% endif %}
        <label class="list-tools__search">
            <span>{{ 'Search'|trans({}, 'quire-admin') }}</span>
            <input type="search" name="q" value="{{ state.q }}" autocomplete="off">
        </label>
        {% for id, filter in filters %}
            <label>
                <span>{{ filter.label }}</span>
                <select name="filter[{{ id }}]">
                    <option value="">{{ 'Any'|trans({}, 'quire-admin') }}</option>
                    {% for value, label in filter.choices %}
                        <option value="{{ value }}"{% if state.filter[id] is defined and state.filter[id] == value %} selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                </select>
            </label>
        {% endfor %}
        <button type="submit" class="button">{{ 'Show'|trans({}, 'quire-admin') }}</button>
    </form>

    <form method="post" action="{{ action_url }}" class="content-list" data-controller="content-list">
        <input type="hidden" name="_token" value="{{ csrf_token('quire_admin_content_list') }}">
        <input type="hidden" name="state" value="{{ state_query }}">

        {% if bulk_actions is not empty and rows is not empty %}
            <div class="bulk">
                <label>
                    <span>{{ 'Action for the selected items'|trans({}, 'quire-admin') }}</span>
                    <select name="action">
                        <option value="">{{ 'Choose an action'|trans({}, 'quire-admin') }}</option>
                        {% for action, label in bulk_actions %}
                            <option value="{{ action }}">{{ label }}</option>
                        {% endfor %}
                    </select>
                </label>
                <button type="submit" class="button" name="bulk" value="1"{% if trash %} data-turbo-confirm="{{ 'Items deleted permanently can\'t be restored. Continue?'|trans({}, 'quire-admin') }}"{% endif %}>{{ 'Apply'|trans({}, 'quire-admin') }}</button>
            </div>
        {% endif %}

        {% if rows is empty %}
            <p class="empty">
                {% if state.q or state.filter is not empty %}
                    {{ 'Nothing matches.'|trans({}, 'quire-admin') }}
                {% elseif trash %}
                    {{ 'The trash is empty.'|trans({}, 'quire-admin') }}
                {% else %}
                    {{ 'Nothing here yet.'|trans({}, 'quire-admin') }}
                {% endif %}
            </p>
        {% else %}
            <div class="table-scroll">
                <table class="table content-list__table">
                    <caption class="visually-hidden">
                        {{ plural }}, {{ 'page {page} of {pages}'|trans({page: page.page, pages: page.pageCount}, 'quire-admin') }}
                    </caption>
                    <thead>
                        <tr>
                            <td class="content-list__select">
                                <input type="checkbox" hidden data-content-list-target="all" data-action="content-list#toggleAll" aria-label="{{ 'Select all'|trans({}, 'quire-admin') }}">
                            </td>
                            {% for column in columns %}
                                <th scope="col"{% if column.sorted %} aria-sort="{{ column.sorted == 'asc' ? 'ascending' : 'descending' }}"{% endif %}>
                                    {% if column.sort_url %}
                                        <a href="{{ column.sort_url }}">{{ column.label }}</a>
                                    {% else %}
                                        {{ column.label }}
                                    {% endif %}
                                </th>
                            {% endfor %}
                            <th scope="col"><span class="visually-hidden">{{ 'Actions'|trans({}, 'quire-admin') }}</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            {% set item = row.item %}
                            <tr>
                                <td class="content-list__select">
                                    <input type="checkbox" name="ids[]" value="{{ item.id }}" id="select-{{ item.id }}" data-content-list-target="item" data-action="content-list#update">
                                    <label for="select-{{ item.id }}" class="visually-hidden">{{ 'Select “{title}”'|trans({title: item.title}, 'quire-admin') }}</label>
                                </td>
                                {% for cell in row.cells %}
                                    {% if loop.first %}
                                        <th scope="row">
                                            <a class="content-list__title" href="{{ path('quire_admin_content_edit', {type: type.id, id: item.id}) }}">{{ cell }}</a>
                                            {% if item.isPublic %}
                                                <a class="meta" href="{{ quire_url(item) }}">{{ 'View'|trans({}, 'quire-admin') }}<span class="visually-hidden"> “{{ item.title }}”</span></a>
                                            {% endif %}
                                        </th>
                                    {% else %}
                                        <td>{{ cell }}</td>
                                    {% endif %}
                                {% endfor %}
                                <td class="content-list__actions">
                                    {% for action, label in row.actions %}
                                        <button type="submit" class="link-button{% if action in ['trash', 'purge'] %} link-button--danger{% endif %}" name="row" value="{{ action }}|{{ item.id }}"{% if action == 'purge' %} data-turbo-confirm="{{ '“{title}” will be deleted permanently and can\'t be restored. Continue?'|trans({title: item.title}, 'quire-admin') }}"{% endif %}>
                                            {{ label }}<span class="visually-hidden"> “{{ item.title }}”</span>
                                        </button>
                                    {% endfor %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </form>

    {% if page.pageCount > 1 %}
        <nav class="pagination" aria-label="{{ 'Pages'|trans({}, 'quire-admin') }}">
            {% if previous_url %}
                <a href="{{ previous_url }}" rel="prev">{{ 'Previous'|trans({}, 'quire-admin') }}</a>
            {% endif %}
            <span>{{ 'Page {page} of {pages}'|trans({page: page.page, pages: page.pageCount}, 'quire-admin') }}</span>
            {% if next_url %}
                <a href="{{ next_url }}" rel="next">{{ 'Next'|trans({}, 'quire-admin') }}</a>
            {% endif %}
        </nav>
    {% endif %}
{% endblock %}
