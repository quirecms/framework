{#
    What the content checks found (a CheckReport): errors, which block publishing, then warnings, each
    linking to where it is. Variables: checks.
#}
{% set errors = checks.errors|length %}
{% set warnings = checks.warnings|length %}
<p class="checks__summary">
    {%- if errors == 0 and warnings == 0 -%}
        {{ 'The checks found nothing.'|trans({}, 'quire-admin') }}
    {%- else -%}
        {{ '{errors, plural, =0 {No errors} one {# error} other {# errors}}, {warnings, plural, =0 {no warnings} one {# warning} other {# warnings}}.'|trans({errors: errors, warnings: warnings}, 'quire-admin') }}
        {% if errors > 0 %}{{ 'Errors block publishing.'|trans({}, 'quire-admin') }}{% endif %}
    {%- endif -%}
</p>
{% if checks.results is not empty %}
    <ul class="checks">
        {% for result in checks.results %}
            {% set property = result.finding.property ?? 'body' %}
            {% set target = property starts with 'fields.' ? 'field-' ~ property[7:] : property %}
            <li class="checks__item checks__item--{{ result.level.value }}">
                <strong>{{ ('check.' ~ result.level.value)|trans({}, 'quire-admin') }}:</strong>
                {{ result.finding.message }}
                <a href="#{{ target }}" class="meta">{{ result.finding.line ? 'Line {line}'|trans({line: result.finding.line}, 'quire-admin') : 'Go there'|trans({}, 'quire-admin') }}<span class="visually-hidden"> ({{ result.label }})</span></a>
            </li>
        {% endfor %}
    </ul>
{% endif %}
