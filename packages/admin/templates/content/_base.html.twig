{#
    What the content screens share: the heading with the type's count, the switch between the list, the
    board ("In motion") and the calendar, and "New"; the same on each, so nothing moves when switching.
    (Density is one of the person's preferences.) The screens fill "screen".
    Variables: type, state, can_create, total, modes.
#}
{% extends '@quire_admin/layout.html.twig' %}

{% set plural = type.pluralLabel|trans({}, type.owner) %}

{% block title %}{{ plural }}{% endblock %}

{% block heading %}{{ plural }} <span class="q-page-head__count">{{ total|quire_admin_number }}</span>{% endblock %}

{% block actions %}
    <div class="content-head__tools">
        <nav class="q-seg" aria-label="{{ 'Show as'|trans({}, 'quire-admin') }}">
            {% for mode in modes %}
                <a href="{{ mode.url }}"{% if mode.current %} aria-current="page"{% endif %}>{{ ('mode.' ~ mode.id)|trans({}, 'quire-admin') }}</a>
            {% endfor %}
        </nav>
        {% if can_create %}
            <a class="q-btn" href="{{ path('quire_admin_content_new', {type: type.id}) }}"><span aria-hidden="true">＋</span> {{ 'New {type}'|trans({type: (type.label|trans({}, type.owner))|lower}, 'quire-admin') }}</a>
        {% endif %}
    </div>
{% endblock %}
