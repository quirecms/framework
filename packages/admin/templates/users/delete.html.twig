{#
    Deleting a user, after choosing who gets their content. Variables: user, content_count, heirs (other
    users), error.
#}
{% extends '@quire_admin/layout.html.twig' %}

{% block title %}{{ 'Delete {name}?'|trans({name: user.displayName}, 'quire-admin') }}{% endblock %}

{% block content %}
    {% if error %}<p class="q-notice q-notice--error" role="alert">{{ error }}</p>{% endif %}
    <p>{{ 'Deleting {name} can\'t be undone. Suspending keeps them, without letting them sign in.'|trans({name: user.displayName}, 'quire-admin') }}</p>

    <form method="post" action="{{ path('quire_admin_user_delete', {id: user.id}) }}" class="settings-form">
        <input type="hidden" name="_token" value="{{ csrf_token('quire_admin_users') }}">
        {% if content_count > 0 %}
            <div class="q-field">
                <label for="reassign">{{ '{count, plural, one {Who gets their # item?} other {Who gets their # items?}}'|trans({count: content_count}, 'quire-admin') }}</label>
                <p class="q-help" id="reassign-help">{{ 'The content stays; it gets this author, or none.'|trans({}, 'quire-admin') }}</p>
                <select id="reassign" name="reassign" aria-describedby="reassign-help">
                    <option value="">{{ 'No one'|trans({}, 'quire-admin') }}</option>
                    {% for heir in heirs %}<option value="{{ heir.id }}">{{ heir.displayName }} ({{ heir.username }})</option>{% endfor %}
                </select>
            </div>
        {% endif %}
        <div class="editor__buttons">
            <button type="submit" class="q-btn q-btn--danger">{{ 'Delete {name}'|trans({name: user.displayName}, 'quire-admin') }}</button>
            <a href="{{ path('quire_admin_user', {id: user.id}) }}">{{ 'Cancel'|trans({}, 'quire-admin') }}</a>
        </div>
    </form>
{% endblock %}
