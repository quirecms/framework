{#
    The site's people. Variables: users (rows: user, status, new, invitation), total, state (view, q, sort),
    tabs (view, label, count, url, attention?), current (the tab shown), roles (labels by name), sentences
    (what each role may do, by name), invitation_problem, columns (id, sorted, sort_url), page, pages,
    previous_url, next_url, back.
#}
{% extends '@quire_admin/layout.html.twig' %}

{% block title %}{{ 'People'|trans({}, 'quire-admin') }}{% endblock %}

{% block page_head %}
    {% embed '@quire_admin/users/_head.html.twig' with {title: current.label, count: current.count, current: 'users'} %}
        {% block actions %}
            {% if invitation_problem is null %}<a class="q-btn" href="#invite-emails">{{ 'Invite people'|trans({}, 'quire-admin') }}</a>{% endif %}
            <a class="q-btn q-btn--ghost" href="{{ path('quire_admin_user_new') }}">{{ 'Add a user'|trans({}, 'quire-admin') }}</a>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block content %}
    <div class="people-bar">
        <nav class="q-views" aria-label="{{ 'Whom to show'|trans({}, 'quire-admin') }}">
            <ul>
                {% for tab in tabs %}
                    <li><a href="{{ tab.url }}"{% if tab.view == state.view %} aria-current="page"{% endif %}>{{ tab.label }} <span class="q-views__count{% if tab.attention|default(false) and tab.count > 0 %} q-views__count--attention{% endif %}">{{ tab.count|quire_admin_number }}</span></a></li>
                {% endfor %}
            </ul>
        </nav>
        <form class="people-bar__search" role="search" method="get" action="{{ path('quire_admin_users') }}">
            {% if state.view %}<input type="hidden" name="view" value="{{ state.view }}">{% endif %}
            {% if state.sort != 'name' %}<input type="hidden" name="sort" value="{{ state.sort }}">{% endif %}
            <label for="people-q" class="q-sr">{{ 'Search people'|trans({}, 'quire-admin') }}</label>
            <input type="search" id="people-q" name="q" value="{{ state.q }}" autocomplete="off" placeholder="{{ 'Name, username or email'|trans({}, 'quire-admin') }}">
            <button type="submit" class="q-btn q-btn--ghost">{{ 'Search'|trans({}, 'quire-admin') }}</button>
        </form>
    </div>

    <div class="people">
        <section class="q-card people__list" aria-label="{{ current.label }}">
            {% if users is empty %}
                <p class="q-empty">{{ state.q or state.view ? 'Nothing matches.'|trans({}, 'quire-admin') : 'Nothing here yet.'|trans({}, 'quire-admin') }}</p>
            {% else %}
                <div class="q-scroll">
                    <table class="q-table people-table">
                        <caption class="q-sr">{{ current.label }}, {{ 'page {page} of {pages}'|trans({page: page, pages: pages}, 'quire-admin') }}</caption>
                        <thead>
                            <tr>
                                {% set by = columns|filter(c => c.id == 'name')|first %}
                                <th scope="col"{% if by.sorted %} aria-sort="{{ by.sorted == 'asc' ? 'ascending' : 'descending' }}"{% endif %}><a href="{{ by.sort_url }}">{{ 'Person'|trans({}, 'quire-admin') }}</a></th>
                                <th scope="col">{{ 'Roles'|trans({}, 'quire-admin') }}</th>
                                <th scope="col">{{ 'Status'|trans({}, 'quire-admin') }}</th>
                                {% set by = columns|filter(c => c.id == 'login')|first %}
                                <th scope="col"{% if by.sorted %} aria-sort="{{ by.sorted == 'asc' ? 'ascending' : 'descending' }}"{% endif %}><a href="{{ by.sort_url }}">{{ 'Last seen'|trans({}, 'quire-admin') }}</a></th>
                                <th scope="col"><span class="q-sr">{{ 'Next step'|trans({}, 'quire-admin') }}</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in users %}
                                {% set user = row.user %}
                                <tr>
                                    <th scope="row">
                                        <span class="people-person">
                                            <span class="q-avatar people-person__avatar" aria-hidden="true">{{ user.displayName|split(' ')|map(word => word|first)|slice(0, 2)|join|upper }}</span>
                                            <span>
                                                <a class="people-person__name" href="{{ path('quire_admin_user', {id: user.id}) }}">{{ user.displayName }}</a>
                                                <span class="people-person__email">{{ user.email ?? user.username }}</span>
                                            </span>
                                        </span>
                                    </th>
                                    <td data-label="{{ 'Roles'|trans({}, 'quire-admin') }}">
                                        <span class="people-roles">
                                            {% for role in user.roles %}<span class="q-tag">{{ roles[role] ?? role }}</span>{% else %}<span class="q-meta">—</span>{% endfor %}
                                        </span>
                                    </td>
                                    <td data-label="{{ 'Status'|trans({}, 'quire-admin') }}">
                                        <span class="people-status people-status--{{ row.status }}">
                                            {%- if row.status == 'invited' -%}
                                                {{ 'Invited {when}'|trans({when: row.invitation.sentAt|quire_admin_when}, 'quire-admin')|raw }}
                                            {%- elseif row.status == 'expired' -%}
                                                {{ 'Invitation expired'|trans({}, 'quire-admin') }}
                                            {%- else -%}
                                                {{ ('users.status.' ~ (row.status == 'suspended' ? 'suspended' : 'active'))|trans({}, 'quire-admin') }}
                                            {%- endif -%}
                                        </span>
                                        {% if row.new %}<span class="q-tag people-new">{{ 'new'|trans({}, 'quire-admin') }}</span>{% endif %}
                                    </td>
                                    <td data-label="{{ 'Last seen'|trans({}, 'quire-admin') }}">{{ user.lastLoginAt ? user.lastLoginAt|quire_admin_when : 'not yet'|trans({}, 'quire-admin') }}</td>
                                    <td class="people-next">
                                        {% if row.status == 'suspended' %}
                                            <form method="post" action="{{ path('quire_admin_user_act', {id: user.id, action: 'activate'}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('quire_admin_users') }}">
                                                <input type="hidden" name="back" value="{{ back }}">
                                                <button type="submit" class="q-link-btn">{{ 'Let in again'|trans({}, 'quire-admin') }}<span class="q-sr"> ({{ user.displayName }})</span></button>
                                            </form>
                                        {% elseif row.status in ['invited', 'expired'] and invitation_problem is null %}
                                            <form method="post" action="{{ path('quire_admin_user_act', {id: user.id, action: 'invite'}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('quire_admin_users') }}">
                                                <input type="hidden" name="back" value="{{ back }}">
                                                <button type="submit" class="q-link-btn">{{ 'Send again'|trans({}, 'quire-admin') }}<span class="q-sr"> ({{ user.displayName }})</span></button>
                                            </form>
                                        {% elseif is_granted('quire.audit.view') %}
                                            <a href="{{ path('quire_admin_audit', {actor: user.id}) }}">{{ 'Activity'|trans({}, 'quire-admin') }}<span class="q-sr"> ({{ user.displayName }})</span></a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}

            {% if pages > 1 %}
                <nav class="q-pagination people__pages" aria-label="{{ 'Pages'|trans({}, 'quire-admin') }}">
                    {% if previous_url %}<a href="{{ previous_url }}" rel="prev">{{ 'Previous'|trans({}, 'quire-admin') }}</a>{% endif %}
                    <span>{{ 'Page {page} of {pages}'|trans({page: page, pages: pages}, 'quire-admin') }}</span>
                    {% if next_url %}<a href="{{ next_url }}" rel="next">{{ 'Next'|trans({}, 'quire-admin') }}</a>{% endif %}
                </nav>
            {% endif %}
        </section>

        <aside class="q-card people__invite" aria-labelledby="invite-heading">
            <h2 id="invite-heading" class="home-card__title">{{ 'Invite people'|trans({}, 'quire-admin') }}</h2>
            {% if invitation_problem %}
                <p class="q-help">{{ invitation_problem }}</p>
            {% else %}
                {% set first_role = roles|keys|filter(role => role != 'admin')|first ?: (roles|keys|first) %}
                <form method="post" action="{{ path('quire_admin_users_invite') }}" class="invite-form" data-controller="invite-form"
                      data-invite-form-labels-value="{{ {one: 'Send 1 invitation'|trans({}, 'quire-admin'), other: 'Send {count} invitations'|trans({count: '%count%'}, 'quire-admin'), none: 'Send invitations'|trans({}, 'quire-admin')}|json_encode }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('quire_admin_users') }}">
                    <div class="q-field">
                        <label for="invite-emails">{{ 'Emails, one or many'|trans({}, 'quire-admin') }}</label>
                        <textarea id="invite-emails" name="emails" rows="3" required data-invite-form-target="emails" data-action="input->invite-form#count" placeholder="ana@example.org, ben@example.org"></textarea>
                    </div>
                    <div class="q-field">
                        <label for="invite-role">{{ 'As'|trans({}, 'quire-admin') }}</label>
                        <select id="invite-role" name="role" data-invite-form-target="role" data-action="invite-form#describe" aria-describedby="invite-sentence">
                            {% for name, label in roles %}<option value="{{ name }}"{% if name == first_role %} selected{% endif %} data-sentence="{{ sentences[name] }}">{{ label }}</option>{% endfor %}
                        </select>
                        <p class="q-help" id="invite-sentence" data-invite-form-target="sentence" aria-live="polite">{{ sentences[first_role] ?? '' }}</p>
                    </div>
                    <button type="submit" class="q-btn invite-form__send" data-invite-form-target="send">{{ 'Send invitations'|trans({}, 'quire-admin') }}</button>
                    <p class="q-help">{{ 'They choose their own password. The link works once, for 7 days.'|trans({}, 'quire-admin') }}</p>
                </form>
            {% endif %}
        </aside>
    </div>
{% endblock %}
