{#
    Adding a user (user is null) or changing one. Variables: user, values (display_name, email, username,
    roles, password_mode), errors (by field: displayName, email, username, roles, password), roles (labels
    by name), host_roles (roles mapped from the host application), identities, content_count,
    invitation_problem (why users can't be invited), self (whether it's the signed-in user), timezone.
#}
{% extends '@quire_admin/layout.html.twig' %}

{% set ids = {displayName: 'display_name', email: 'email', username: 'username', password: 'password', roles: 'role-' ~ (roles|keys|first)} %}

{% block title %}{{ user ? user.displayName : 'Add a user'|trans({}, 'quire-admin') }}{% endblock %}

{% block page_head %}
    {% set user_actions %}
    {% if user and is_granted('quire.audit.view') %}
        <p class="q-page-head__links">
            <a href="{{ path('quire_admin_audit', {actor: user.id}) }}">{{ 'What they did'|trans({}, 'quire-admin') }}</a>
            <a href="{{ path('quire_admin_audit', {subject_type: 'user', subject: user.id}) }}">{{ 'Changes to the user'|trans({}, 'quire-admin') }}</a>
        </p>
    {% endif %}
    {% if user and not self and is_granted('quire.users.view_as') %}
        {% if view_as_refusal is null %}
            {# Seeing the admin as them, read-only: core's bar on every page stops it. #}
            <form method="post" action="{{ path('quire_view_as') }}" class="view-as-form">
                <input type="hidden" name="_token" value="{{ csrf_token('quire_view_as') }}">
                <input type="hidden" name="user" value="{{ user.id }}">
                {# Where they'd start: the admin, or the site when they can't open the admin. #}
                <input type="hidden" name="back" value="{{ view_as_admin ? path('quire_admin_dashboard') : path('quire_home') }}">
                <button type="submit" class="q-btn q-btn--ghost">{{ (view_as_admin ? 'See the admin as {name}' : 'See the site as {name}')|trans({name: user.displayName|split(' ')|first}, 'quire-admin') }}</button>
            </form>
        {% else %}
            <p class="q-help">{{ view_as_refusal }}</p>
        {% endif %}
    {% endif %}
    {% endset %}
    {% embed '@quire_admin/users/_head.html.twig' with {title: block('title'), current: 'users'} %}
        {% block actions %}{{ user_actions }}{% endblock %}
    {% endembed %}
{% endblock %}

{% block content %}
    {% if errors is not empty %}
        <div class="q-error-summary" role="alert" tabindex="-1" data-controller="focus">
            <h2>{{ 'There\'s a problem'|trans({}, 'quire-admin') }}</h2>
            <ul>{% for field, message in errors %}<li><a href="#{{ ids[field] ?? 'display_name' }}">{{ message }}</a></li>{% endfor %}</ul>
        </div>
    {% endif %}

    <div class="editor">
        <form method="post" action="{{ user ? path('quire_admin_user', {id: user.id}) : path('quire_admin_user_new') }}" class="settings-form" novalidate>
            <input type="hidden" name="_token" value="{{ csrf_token('quire_admin_users') }}">

            {% for field, label in {display_name: 'Name', email: 'Email', username: 'Username'} %}
                {% set key = field == 'display_name' ? 'displayName' : field %}
                <div class="q-field">
                    <label for="{{ field }}">{{ label|trans({}, 'quire-admin') }}</label>
                    {% if field == 'username' and not user %}<p class="q-help" id="username-help">{{ 'Made from the email or name when left empty.'|trans({}, 'quire-admin') }}</p>{% endif %}
                    {% if errors[key] is defined %}<p class="q-error" id="{{ field }}-error">{{ errors[key] }}</p>{% endif %}
                    <input type="{{ field == 'email' ? 'email' : 'text' }}" id="{{ field }}" name="{{ field }}" value="{{ values[field] }}"
                        autocomplete="{{ field == 'display_name' ? 'name' : (field == 'email' ? 'email' : 'username') }}" spellcheck="false"
                        {% if field == 'display_name' %}required{% endif %}
                        {% if errors[key] is defined %} aria-invalid="true" aria-describedby="{{ field }}-error"{% elseif field == 'username' and not user %} aria-describedby="username-help"{% endif %}>
                </div>
            {% endfor %}

            <fieldset class="q-field">
                <legend>{{ 'Roles'|trans({}, 'quire-admin') }}</legend>
                {% if errors.roles is defined %}<p class="q-error" id="roles-error">{{ errors.roles }}</p>{% endif %}
                <ul class="q-choices">
                    {% for name, label in roles %}
                        <li>
                            <input type="checkbox" id="role-{{ name }}" name="roles[]" value="{{ name }}"{% if name in values.roles %} checked{% endif %}>
                            <label for="role-{{ name }}">{{ label }}</label>
                            <a class="q-meta" href="{{ path('quire_admin_role', {role: name}) }}">{{ 'what they may do'|trans({}, 'quire-admin') }}<span class="q-sr"> ({{ label }})</span></a>
                        </li>
                    {% endfor %}
                </ul>
                {% if host_roles is not empty %}
                    <p class="q-help">{{ 'From the application, on every request: {roles}.'|trans({roles: host_roles|map(role => roles[role] ?? role)|join(', ')}, 'quire-admin') }}</p>
                {% endif %}
            </fieldset>

            {% if user %}
                <div class="q-field">
                    <label for="password">{{ 'New password'|trans({}, 'quire-admin') }}</label>
                    <p class="q-help" id="password-help">{{ 'Leave empty to keep it. Better: invite them to choose one themselves.'|trans({}, 'quire-admin') }}</p>
                    {% if errors.password is defined %}<p class="q-error" id="password-error">{{ errors.password }}</p>{% endif %}
                    <input type="password" id="password" name="password" autocomplete="new-password" aria-describedby="password-help{% if errors.password is defined %} password-error{% endif %}"{% if errors.password is defined %} aria-invalid="true"{% endif %}>
                </div>
            {% else %}
                <fieldset class="q-field">
                    <legend>{{ 'Password'|trans({}, 'quire-admin') }}</legend>
                    {% if errors.password is defined %}<p class="q-error" id="password-error">{{ errors.password }}</p>{% endif %}
                    <ul class="q-choices">
                        <li>
                            <input type="radio" id="password-invite" name="password_mode" value="invite"{% if values.password_mode == 'invite' %} checked{% endif %}{% if invitation_problem %} disabled{% endif %}>
                            <label for="password-invite">{{ 'Email them a link to choose it (recommended)'|trans({}, 'quire-admin') }}</label>
                        </li>
                        <li>
                            <input type="radio" id="password-set" name="password_mode" value="set"{% if values.password_mode == 'set' %} checked{% endif %}>
                            <label for="password-set">{{ 'Set it now'|trans({}, 'quire-admin') }}</label>
                        </li>
                        <li>
                            <input type="radio" id="password-none" name="password_mode" value="none"{% if values.password_mode == 'none' %} checked{% endif %}>
                            <label for="password-none">{{ 'None: they sign in another way, e.g. with single sign-on'|trans({}, 'quire-admin') }}</label>
                        </li>
                    </ul>
                    {% if invitation_problem %}<p class="q-help">{{ invitation_problem }}</p>{% endif %}
                    <label for="password">{{ 'Password, if you set it now'|trans({}, 'quire-admin') }}</label>
                    <input type="password" id="password" name="password" autocomplete="new-password"{% if errors.password is defined %} aria-invalid="true" aria-describedby="password-error"{% endif %}>
                </fieldset>
            {% endif %}

            <div class="editor__buttons">
                <button type="submit" class="q-btn">{{ user ? 'Save'|trans({}, 'quire-admin') : 'Add the user'|trans({}, 'quire-admin') }}</button>
                <a href="{{ path('quire_admin_users') }}">{{ 'Cancel'|trans({}, 'quire-admin') }}</a>
            </div>
        </form>

        {% if user %}
            <aside class="editor__side">
                <section class="q-card">
                    <h2 class="q-card__title">{{ 'Account'|trans({}, 'quire-admin') }}</h2>
                    <p>
                        <span class="q-tag {{ user.active ? 'q-tag--ok' : 'q-tag--err' }}">{{ ('users.status.' ~ user.status)|trans({}, 'quire-admin') }}</span>
                        {% if user.email and not user.emailVerifiedAt %} · {{ 'email not confirmed'|trans({}, 'quire-admin') }}{% endif %}
                    </p>
                    <p class="q-meta">
                        {{ 'Added {date}'|trans({date: user.createdAt|date('Y-m-d', timezone)}, 'quire-admin') }} ·
                        {{ user.lastLoginAt ? 'last signed in {date}'|trans({date: user.lastLoginAt|date('Y-m-d H:i', timezone)}, 'quire-admin') : 'never signed in'|trans({}, 'quire-admin') }}
                    </p>
                    <p class="q-meta">{{ '{count, plural, =0 {No content} one {Author of # item} other {Author of # items}}'|trans({count: content_count}, 'quire-admin') }}</p>
                    <div class="q-card__actions">
                    <a class="q-link-btn" href="{{ path('quire_admin_access', {user: user.username}) }}">{{ 'Check what they may do'|trans({}, 'quire-admin') }}</a>
                    {% if user.email and not invitation_problem %}
                        <form method="post" action="{{ path('quire_admin_user_act', {id: user.id, action: 'invite'}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('quire_admin_users') }}">
                            <button type="submit" class="q-link-btn">{{ user.passwordHash ? 'Email a link to choose a new password'|trans({}, 'quire-admin') : 'Invite again'|trans({}, 'quire-admin') }}</button>
                        </form>
                    {% endif %}
                    {% if not self %}
                        <form method="post" action="{{ path('quire_admin_user_act', {id: user.id, action: user.active ? 'suspend' : 'activate'}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('quire_admin_users') }}">
                            <button type="submit" class="q-link-btn{% if user.active %} q-link-btn--danger{% endif %}">{{ user.active ? 'Suspend'|trans({}, 'quire-admin') : 'Activate'|trans({}, 'quire-admin') }}</button>
                        </form>
                        <a class="q-link-btn q-link-btn--danger" href="{{ path('quire_admin_user_delete', {id: user.id}) }}">{{ 'Delete'|trans({}, 'quire-admin') }}</a>
                    {% endif %}
                    </div>
                </section>
                {% if identities is not empty %}
                    <section class="q-card">
                        <h2 class="q-card__title">{{ 'Signs in with'|trans({}, 'quire-admin') }}</h2>
                        <ul class="q-list">
                            {% for identity in identities %}
                                <li><span>{{ identity.provider == 'host' ? 'The application'|trans({}, 'quire-admin') : identity.provider }}</span> <span class="q-meta">{{ identity.subject }}{% if identity.last_used_at %} · {{ identity.last_used_at|date('Y-m-d', timezone) }}{% endif %}</span></li>
                            {% endfor %}
                        </ul>
                    </section>
                {% endif %}
            </aside>
        {% endif %}
    </div>
{% endblock %}
