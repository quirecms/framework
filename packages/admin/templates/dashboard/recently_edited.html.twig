{% import '@quire_admin/_ui.html.twig' as ui %}
{% if items is empty %}
    <p class="q-empty">{{ 'Nothing has been written yet.'|trans({}, 'quire-admin') }}</p>
{% else %}
    <ul class="q-list">
        {% for item in items %}
            <li>
                {% if item.isPublic %}
                    <a href="{{ quire_url(item) }}">{{ item.title }}</a>
                {% else %}
                    <span>{{ item.title }}</span>
                {% endif %}
                <span class="q-meta">
                    {{ types[item.type].label }} ·
                    {{ ui.status(item.status) }} ·
                    <time datetime="{{ item.updatedAt|date('c') }}">{{ item.updatedAt|date('Y-m-d H:i') }}</time>
                </span>
            </li>
        {% endfor %}
    </ul>
{% endif %}
