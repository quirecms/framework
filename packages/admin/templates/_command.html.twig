{#
    The console commands that do what was just done, or what an audit entry records. Variables: commands
    (list of strings), label (whether to say "As a command"; default true). Without JavaScript there's no
    copy button.
#}
<div class="q-command" data-controller="copy" data-copy-copied-value="{{ 'Copied'|trans({}, 'quire-admin') }}">
    {% if label ?? true %}<span class="q-command__label">{{ 'As a command'|trans({}, 'quire-admin') }}</span>{% endif %}
    <code class="q-command__text" data-copy-target="source">{{ commands|join("\n") }}</code>
    <button type="button" class="q-btn q-btn--ghost q-command__copy" data-copy-target="button" data-action="copy#copy" hidden>{{ 'Copy'|trans({}, 'quire-admin') }}</button>
    <span class="q-sr" role="status" data-copy-target="status"></span>
</div>
