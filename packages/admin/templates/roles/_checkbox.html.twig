{# One ability's box. Variables: name, label, has, defaults, everyone (Everyone's abilities), beyond (those the person can't give), hide_label. #}
{% set id = 'ability-' ~ name|replace({'.': '-'}) %}
{% set default = name in defaults %}
{% set on = name in has %}
{% set locked = name in (beyond ?? []) %}
<input type="checkbox" id="{{ id }}" name="abilities[]" value="{{ name }}"{% if on %} checked{% endif %}{% if locked %} disabled{% endif %} aria-describedby="{{ id }}-state{% if locked %} {{ id }}-locked{% endif %}">
<label for="{{ id }}"{% if hide_label ?? false %} class="q-sr"{% endif %}>{{ label }}</label>
<span class="ability__state{% if on != default %} ability__state--changed{% endif %}" id="{{ id }}-state">
    {%- if on != default -%}{{ (default ? 'changed: by default it has this' : 'changed: by default it hasn\'t this')|trans({}, 'quire-admin') }}{%- endif -%}
</span>
{% if locked %}<span class="ability__locked q-meta" id="{{ id }}-locked">{{ 'You don\'t have this, so you can\'t give it or take it away.'|trans({}, 'quire-admin') }}</span>{% endif %}
{% if not on and name in everyone %}<span class="ability__everyone">{{ 'everyone may'|trans({}, 'quire-admin') }}</span>{% endif %}
