{#
    Choosing a new password, after opening the emailed link, or a first one when invited.

    Variables: user (whose password it is), errors (password, form), route (where the form goes),
    invitation (whether it's their first)
#}
{% extends 'layout.html.twig' %}

{% set heading = (invitation ?? false) ? 'Choose your password' : 'Choose a new password' %}

{% block title %}{{ heading|trans({}, 'quire') }} – {{ site.title }}{% endblock %}

{% block content %}
    <section class="sign-in">
        <h1>{{ heading|trans({}, 'quire') }}</h1>
        {% if invitation ?? false %}<p>{{ 'Welcome to {site}, {name}. Choose the password you\'ll sign in with as {username}.'|trans({site: site.title, name: user.displayName, username: user.username}, 'quire') }}</p>{% endif %}

        {% if errors.form is defined %}
            <p class="form-error" role="alert">{{ errors.form|trans({}, 'quire') }}</p>
        {% endif %}

        <form method="post" action="{{ path(route ?? 'quire_reset_password') }}" class="form" novalidate>
            {# Lets password managers save the new password for the right account. #}
            <input type="hidden" name="username" value="{{ user.email }}" autocomplete="username">
            <p class="form-field">
                <label for="password">{{ 'New password'|trans({}, 'quire') }}</label>
                <input type="password" id="password" name="password" autocomplete="new-password" minlength="8" required aria-describedby="password-hint{% if errors.password is defined %} password-error{% endif %}"{% if errors.password is defined %} aria-invalid="true"{% endif %}>
                <span class="form-hint" id="password-hint">{{ 'At least 8 characters.'|trans({}, 'quire') }}</span>
                {% if errors.password is defined %}<span class="form-error" id="password-error">{{ errors.password|trans({}, 'quire') }}</span>{% endif %}
            </p>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}">
            <p><button type="submit">{{ ((invitation ?? false) ? 'Save password' : 'Change password')|trans({}, 'quire') }}</button></p>
        </form>
    </section>
{% endblock %}
