{#
    Asks for the email to send a password reset link to, when "quire.auth.password_reset" is on.

    Variables: email (what was typed), errors (form: why the form wasn't accepted)
#}
{% extends 'layout.html.twig' %}

{% block title %}{{ 'Forgot your password?'|trans({}, 'quire') }} – {{ site.title }}{% endblock %}

{% block content %}
    <section class="sign-in">
        <h1>{{ 'Forgot your password?'|trans({}, 'quire') }}</h1>
        <p>{{ 'Enter your email address, and we\'ll send you a link to choose a new password.'|trans({}, 'quire') }}</p>

        {% if errors.form is defined %}
            <p class="form-error" role="alert">{{ errors.form|trans({}, 'quire') }}</p>
        {% endif %}

        <form method="post" action="{{ path('quire_forgot_password') }}" class="form">
            <p class="form-field">
                <label for="email">{{ 'Email'|trans({}, 'quire') }}</label>
                <input type="email" id="email" name="email" value="{{ email }}" autocomplete="email" required>
            </p>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">
            <p><button type="submit">{{ 'Send the link'|trans({}, 'quire') }}</button></p>
        </form>

        <p><a href="{{ path('quire_login') }}">{{ 'Back to signing in'|trans({}, 'quire') }}</a></p>
    </section>
{% endblock %}
