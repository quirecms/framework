{#
    A content item. Override it for all types with templates/content/single.html.twig, for one type with
    templates/content/<type>/single.html.twig, or for one item with templates/content/<type>/<slug>.html.twig.

    Variables: content (the item), type (its content type), body (the body as HTML), canonical_url,
    site_title, and anything ContentViewing listeners added.
#}
{% extends 'layout.html.twig' %}

{% block title %}{{ content.title }} – {{ site_title }}{% endblock %}

{% block content %}
    <article>
        <h1>{{ content.title }}</h1>
        {% if content.publishedAt and type.has('scheduling') %}
            <p><time datetime="{{ content.publishedAt|date('c') }}">{{ content.publishedAt|date('j F Y') }}</time></p>
        {% endif %}
        {{ body|raw }}
    </article>
{% endblock %}
