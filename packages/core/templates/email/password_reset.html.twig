{# Variables: user, url (the link to choose a new password) #}
{% extends 'email/layout.html.twig' %}

{% block body %}
    <p>{{ 'Hello {name},'|trans({ name: user.displayName }, 'quire') }}</p>
    <p>{{ 'Someone asked to reset the password of your account. If it was you, choose a new password here:'|trans({}, 'quire') }}</p>
    <p><a href="{{ url }}" style="display: inline-block; padding: 10px 18px; background: #1c184b; color: #ffffff; border-radius: 6px; text-decoration: none;">{{ 'Choose a new password'|trans({}, 'quire') }}</a></p>
    <p>{{ 'The link works once, for one hour. If you didn\'t ask for it, ignore this email: your password stays as it is.'|trans({}, 'quire') }}</p>
{% endblock %}
