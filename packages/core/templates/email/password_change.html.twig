{# Variables: user, url (the link to choose a new password), asked_by (who asked, or null) #}
{% extends 'email/layout.html.twig' %}

{% block body %}
    <p>{{ 'Hello {name},'|trans({ name: user.displayName }, 'quire') }}</p>
    <p>
        {% if asked_by %}
            {{ '{admin} asked you to choose a new password for {site}. Choose it here:'|trans({ admin: asked_by.displayName, site: site.title }, 'quire') }}
        {% else %}
            {{ 'You were asked to choose a new password for {site}. Choose it here:'|trans({ site: site.title }, 'quire') }}
        {% endif %}
    </p>
    <p><a href="{{ url }}" style="display: inline-block; padding: 10px 18px; background: #1c184b; color: #ffffff; border-radius: 6px; text-decoration: none;">{{ 'Choose a new password'|trans({}, 'quire') }}</a></p>
    <p>{{ 'The link works once, for a day. Until you use it, your password stays as it is.'|trans({}, 'quire') }}</p>
{% endblock %}
