{# Variables: user, url (the link to choose a password), invited_by (the admin who invited them, or null) #}
{% extends 'email/layout.html.twig' %}

{% block body %}
    <p>{{ 'Hello {name},'|trans({ name: user.displayName }, 'quire') }}</p>
    <p>
        {% if invited_by %}
            {{ '{admin} added you to {site}, as {username}. Choose your password to sign in:'|trans({ admin: invited_by.displayName, site: site.title, username: user.username }, 'quire') }}
        {% else %}
            {{ 'You were added to {site}, as {username}. Choose your password to sign in:'|trans({ site: site.title, username: user.username }, 'quire') }}
        {% endif %}
    </p>
    <p><a href="{{ url }}" style="display: inline-block; padding: 10px 18px; background: #1c184b; color: #ffffff; border-radius: 6px; text-decoration: none;">{{ 'Choose your password'|trans({}, 'quire') }}</a></p>
    <p>{{ 'The link works once, for seven days.'|trans({}, 'quire') }}</p>
{% endblock %}
