{
    "name": "quire/core",
    "type": "symfony-bundle",
    "description": "The Quire CMS engine: kernel integration, extension system, content model and theming.",
    "keywords": ["cms", "symfony", "quire", "extensible"],
    "homepage": "https://quirecms.com",
    "license": "MIT",
    "authors": [
        {
            "name": "YorvoLabs",
            "homepage": "https://quirecms.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "ext-intl": "*",
        "doctrine/dbal": "^4.2",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/migrations": "^3.9",
        "league/commonmark": "^2.7",
        "league/flysystem": "^3.29",
        "league/flysystem-local": "^3.29",
        "psr/event-dispatcher": "^1.0",
        "sebastian/diff": "^7.0 || ^8.0 || ^9.0",
        "symfony/asset": "^8.1",
        "symfony/asset-mapper": "^8.1",
        "symfony/cache": "^8.1",
        "symfony/config": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/event-dispatcher-contracts": "^3.6",
        "symfony/filesystem": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/html-sanitizer": "^8.1",
        "symfony/mailer": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/process": "^8.1",
        "symfony/property-access": "^8.1",
        "symfony/rate-limiter": "^8.1",
        "symfony/routing": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/service-contracts": "^3.6",
        "symfony/string": "^8.1",
        "symfony/translation": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/workflow": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Quire\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Quire\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "league/flysystem-async-aws-s3": "Storage disks on S3-compatible services (AWS S3, Cloudflare R2, Backblaze B2, SeaweedFS, Garage)"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
