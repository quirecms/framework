{#
    The site's services, for its privacy notice: each one's company, purpose, what it keeps on the
    visitor's device, where data goes and for how long, from their declarations. Placed with
    quire_privacy_services() in a template, or [[privacy_services]] in a page's text.

    Variables: categories (each: category, services), necessary (necessary services).
#}
{%- set domain = 'quire-privacy' -%}
<div class="privacy-services">
    {% if categories is empty and necessary is empty %}
        <p>{{ 'This site uses no services of other companies.'|quire_trans({}, domain) }}</p>
    {% endif %}
    {% for group in (necessary is empty ? [] : [{category: null, services: necessary}])|merge(categories) %}
        <h3>{{ group.category is null ? 'Necessary'|quire_trans({}, domain) : group.category.label|quire_trans({}, domain) }}</h3>
        <p>{{ group.category is null ? 'Needed for the site to work, e.g. to sign in. Always on.'|quire_trans({}, domain) : group.category.description|quire_trans({}, domain) }}</p>
        {% for service in group.services %}
            <h4>{{ service.label }}</h4>
            <dl>
                <dt>{{ 'Run by'|quire_trans({}, domain) }}</dt><dd><bdi>{{ service.vendor }}</bdi></dd>
                <dt>{{ 'What it does'|quire_trans({}, domain) }}</dt><dd>{{ service.purpose|quire_trans({}, quire_domain(service.owner)) }}</dd>
                {% if service.hosts is not empty %}<dt>{{ 'It reaches'|quire_trans({}, domain) }}</dt><dd><ul class="consent__hosts">{% for host in service.reaches %}<li><bdi dir="ltr">{{ host }}</bdi></li>{% endfor %}</ul></dd>{% endif %}
                {% if service.retention %}<dt>{{ 'Its company keeps the data for'|quire_trans({}, domain) }}</dt><dd>{{ service.retention|quire_trans({}, quire_domain(service.owner)) }}</dd>{% endif %}
                {% if service.policyUrl %}<dt>{{ 'Its privacy policy'|quire_trans({}, domain) }}</dt><dd><a href="{{ service.policyUrl }}" rel="noopener"><bdi dir="ltr">{{ service.policyUrl|replace({'https://': ''}) }}</bdi></a></dd>{% endif %}
            </dl>
            {% if service.cookies is not empty %}
                <table>
                    <caption>{{ 'What it keeps on your device'|quire_trans({}, domain) }}</caption>
                    <thead><tr><th scope="col">{{ 'Name'|quire_trans({}, domain) }}</th><th scope="col">{{ 'Kept for'|quire_trans({}, domain) }}</th><th scope="col">{{ 'Purpose'|quire_trans({}, domain) }}</th></tr></thead>
                    <tbody>{% for cookie in service.cookies %}<tr><td><code dir="ltr">{{ cookie.name }}</code></td><td><bdi>{{ cookie.lifetime|quire_trans({}, quire_domain(service.owner)) }}</bdi></td><td>{{ cookie.purpose|quire_trans({}, quire_domain(service.owner)) }}</td></tr>{% endfor %}</tbody>
                </table>
            {% endif %}
        {% endfor %}
    {% endfor %}
    <p>{{ 'You can change your choice at any time with “Cookie settings”.'|quire_trans({}, domain) }}</p>
</div>
