{
    "name": "quire/theme-default",
    "type": "quire-theme",
    "description": "Quire's default theme: accessible, responsive, light and dark, in plain HTML and CSS. Use it as it is, or as the parent of your own theme.",
    "keywords": ["quire", "cms", "theme"],
    "homepage": "https://quirecms.com",
    "license": "MIT",
    "authors": [
        {
            "name": "YorvoLabs",
            "homepage": "https://quirecms.com"
        }
    ],
    "support": {
        "email": "hello@quirecms.com",
        "issues": "https://github.com/quirecms/framework/issues",
        "security": "https://github.com/quirecms/framework/security/policy"
    },
    "require": {
        "php": ">=8.5",
        "quire/core": "^0.3"
    },
    "require-dev": {
        "quire/testing": "^0.3"
    },
    "autoload-dev": {
        "psr-4": {
            "Quire\\ThemeDefault\\Tests\\": "tests/"
        }
    },
    "extra": {
        "quire": {
            "title": "Default",
            "description": "Accessible, responsive, light and dark. Use it as it is, or as the parent of your own theme.",
            "theme": {
                "screenshot": "screenshot.png"
            }
        },
        "branch-alias": {
            "dev-main": "0.3.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
