{#
    A list of items of one content type, e.g. the blog, one page at a time.

    Variables: type (the content type), page (iterate it for the items; page.page, page.pageCount),
    is_home (whether it's the homepage), previous_url, next_url (null when there's no such page),
    canonical_url.
#}
{% extends 'layout.html.twig' %}

{% block title %}{{ is_home ? site.title : type.pluralLabel ~ ' – ' ~ site.title }}{% endblock %}

{% block content %}
    <h1{% if is_home %} class="visually-hidden"{% endif %}>{{ is_home ? site.title : type.pluralLabel }}</h1>

    {% for item in page %}
        {{ include(['content/' ~ type.id ~ '/_card.html.twig', 'content/_card.html.twig'], {item: item, type: type}) }}
    {% else %}
        <p>{{ 'Nothing here yet.'|trans({}, 'quire-theme-default') }}</p>
    {% endfor %}

    {{ include('partials/pagination.html.twig') }}
{% endblock %}
