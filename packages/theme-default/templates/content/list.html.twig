{#
    A list of items of one content type, one page at a time. On the homepage it's the edition: the
    newest post leads, then the rest of its week by day, then the earlier ones by month, and one way into
    the archive ("All posts"), with no pager. Elsewhere it's the archive: every post by month, with the pager.

    Variables: type (the content type), page (iterate it for the items; page.page, page.pageCount,
    page.perPage), is_home (whether it's the homepage), edition (true when the homepage is the type's
    edition, site.homepage = edition, and the list has its own address), previous_url, next_url (null
    when there's no such page), canonical_url.
#}
{% extends 'layout.html.twig' %}
{% import 'partials/rows.html.twig' as rows %}
{% set domain = 'quire-theme-default' %}
{% set dated = type.has('scheduling') and theme.settings.show_dates %}
{% set items = page.items %}
{% set edition = is_home and page.page == 1 %}
{% set archive_title = quire_type_phrase(type, 'all') %}

{% block title %}{{ edition ? site.title : archive_title ~ ' – ' ~ site.title }}{% endblock %}

{% block ribbon %}
    {#- The owner's empty home is theirs alone (private, no-store): it says whose it is, and where to change it -#}
    {% if is_home|default(false) and items is empty and quire_setup_steps() and app.user %}
        {% set who = app.user.displayName ?? app.user.userIdentifier %}
        <div class="qd-ribbon qd-ribbon--notice" role="region" aria-label="{{ 'Only you see this'|trans({}, domain) }}"><div class="qd-container"><span class="qd-tag">{{ 'Only you see this'|quire_trans({}, domain) }}</span><p>{{ 'You’re signed in as {name}, who may change this site.'|quire_trans({name: who}, domain) }}</p>{% if quire_extension_enabled('quire-admin') %}<a href="{{ path('quire_admin_dashboard') }}">{{ 'Open the admin'|quire_trans({}, domain) }}</a>{% endif %}</div></div>
    {% endif %}
{% endblock %}

{% block content %}
    {% if items is empty %}
        {% if is_home %}
            {{ include('partials/welcome.html.twig') }}
        {% else %}
            <div class="qd-container"><header class="qd-list-head"><h1>{{ quire_type_phrase(type, 'all') }}</h1></header><p>{{ 'Nothing here yet.'|quire_trans({}, domain) }}</p></div>
        {% endif %}
    {% else %}
        {#- Each month with items, newest first: where in the list it starts, and so on which page (one query) -#}
        {% set months = {} %}
        {% if dated %}
            {% set counts = quire_content(type.id).locale(site.locale).countBy('published_at', 'month', 1200) %}
            {% set before = 0 %}
            {% for key in counts|keys|sort|reverse %}
                {% set months = months|merge({(key ~ ''): {start: before, page: (before // page.perPage) + 1}}) %}
                {% set before = before + counts[key] %}
            {% endfor %}
        {% endif %}
        {% set shown = items|filter(item => item.publishedAt)|map(item => item.publishedAt|date('Y-m'))|reduce((carry, key) => key in carry ? carry : carry|merge([key]), []) %}

        {% if edition %}
            {{ include('content/_edition.html.twig') }}
        {% else %}
            <div class="qd-container">
                <header class="qd-list-head">
                    <h1>{{ quire_type_phrase(type, 'all') }}</h1>
                    {% set newest = (items|first).publishedAt %}
                    {% set oldest = (items|last).publishedAt %}
                    <p class="qd-meta">{{ 'Page {page} of {count}'|quire_trans({page: page.page, count: page.pageCount}, domain) }}{% if dated and newest and oldest %} · {{ newest|date('Y-m') == oldest|date('Y-m') ? newest|quire_date('month-year') : '{newest} to {oldest}'|quire_trans({newest: newest|quire_date('month-year'), oldest: oldest|quire_date('month-year')}, domain) }}{% endif %}</p>
                </header>
                {% if dated %}
                    <section class="qd-earlier" aria-label="{{ archive_title }}">
                        {% for key in shown %}
                            {% set continued = (months[key].page ?? page.page) < page.page %}
                            <section class="qd-month" aria-labelledby="m-{{ key }}">
                                <h2 class="qd-month__head" id="m-{{ key }}">{{ date(key ~ '-15')|quire_date('month-year') }}{% if continued %} <small>{{ 'continued'|quire_trans({}, domain) }}</small>{% endif %}</h2>
                                <ol class="qd-rows">{% for item in items|filter(item => item.publishedAt and item.publishedAt|date('Y-m') == key) %}{{ rows.row(item, type) }}{% endfor %}</ol>
                            </section>
                        {% endfor %}
                        {% if items|filter(item => not item.publishedAt)|length > 0 %}
                            <ol class="qd-rows">{% for item in items|filter(item => not item.publishedAt) %}{{ rows.row(item, type, false) }}{% endfor %}</ol>
                        {% endif %}
                    </section>
                {% else %}
                    <section class="qd-earlier qd-no-dates" aria-label="{{ archive_title }}"><ol class="qd-rows">{% for item in items %}{{ rows.row(item, type, false) }}{% endfor %}</ol></section>
                {% endif %}
                {{ include('partials/pagination.html.twig') }}
                {% if dated %}{{ include('partials/months.html.twig') }}{% endif %}
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
