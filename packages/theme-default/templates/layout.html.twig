{#
    The page around every page.

    Variables: site (title, description, url, locale, direction), theme (settings), canonical_url when
    the page has one, is_home on the homepage, and the variables of the page's own template.
    minimal: true on pages that must render when the site can't (the error page): no navigation, nothing
    read from the database.
    Blocks: title, fonts (the preloaded fonts), head, ribbon (above the whole site, e.g. the preview notice), header (the masthead
    whole), brand (the link home in it: monogram, name, description), content, footer (the site's footer
    whole), footer_base (its last line: copyright and "Runs on Quire"). A child theme replaces one of them
    and keeps the rest; {{ parent() }} keeps the parent's part. Variables a block sets stay in it: what
    several share (navigation) is set before them.
    Slots: head, body_start, header.nav, sidebar, footer, body_end
#}
{% import 'partials/identity.html.twig' as identity %}
{% set minimal = minimal|default(false) %}
{% set domain = 'quire-theme-default' %}
<!doctype html>
<html lang="{{ app.request.locale|default(site.locale) }}" dir="{{ site.direction }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>{% block title %}{{ site.title }}{% endblock %}</title>
    {% if not minimal %}{{ quire_head() }}{% endif %}
    {# The fonts of the first screen: preloaded, and never swapped in mid-read (font-display: optional), the
       italic too where a page says its first screen has it (italic_first_screen: an item's stand-first). A child
       theme with fonts of its own replaces the block, so these aren't downloaded for nothing. #}
    {% block fonts %}
    {% for font in ['Newsreader-display-latin', 'Newsreader-text-latin', 'Inter-ui-latin']|merge(italic_first_screen ?? false ? ['Newsreader-text-italic-latin'] : []) %}
        <link rel="preload" href="{{ quire_asset('quire-theme-default/fonts/' ~ font ~ '.woff2') }}" as="font" type="font/woff2" crossorigin>
    {% endfor %}
    {% endblock %}
    <link rel="icon" href="{{ quire_asset('quire-theme-default/favicon.svg') }}" type="image/svg+xml">
    {% block head %}{% endblock %}
    {{ quire_slot('head') }}
</head>
<body class="qd-accent-{{ theme.settings.accent }}">
    <a class="skip-link" href="#content">{{ 'Skip to content'|quire_trans({}, domain) }}</a>
    {% block ribbon %}{% endblock %}
    {{ quire_slot('body_start') }}
    {# Read once, for the header and the footer (a block's own variables don't reach the other) #}
    {% set navigation = minimal ? [] : quire_navigation() %}

    {% block header %}
    <header class="qd-masthead">
        <div class="qd-container qd-masthead__main">
            {% block brand %}
            <a class="qd-brand" href="{{ quire_home_url() }}"{% if is_home|default(false) %} aria-current="page"{% endif %} aria-label="{{ '{site}, home page'|trans({site: site.title}, domain) }}">
                {{ identity.monogram(site.title) }}
                <span><span class="qd-brand__name">{{ site.title }}</span>{% if site.description %}<span class="qd-brand__desc">{{ site.description }}</span>{% endif %}</span>
            </a>
            {% endblock %}
            {% if not minimal %}
                {% if quire_slot_filled('header.nav') or navigation|length > 0 %}
                    <nav class="qd-site-nav" aria-label="{{ 'Main'|trans({}, domain) }}">
                        {% if navigation|length > 0 %}
                            {% set shown = navigation|length > 5 ? navigation|slice(0, 4) : navigation %}
                            <ul>{% for item in shown %}<li><a href="{{ item.url }}"{% if item.current %} aria-current="{{ item.current == 'page' ? 'page' : 'true' }}"{% endif %}>{{ item.title }}</a></li>{% endfor %}</ul>
                            {% if navigation|length > 5 %}
                                <details class="qd-nav-more"><summary>{{ 'More'|quire_trans({}, domain) }} <span aria-hidden="true">▾</span></summary>
                                    <ul>{% for item in navigation|slice(4) %}<li><a href="{{ item.url }}"{% if item.current %} aria-current="{{ item.current == 'page' ? 'page' : 'true' }}"{% endif %}>{{ item.title }}</a></li>{% endfor %}</ul>
                                </details>
                            {% endif %}
                        {% endif %}
                        {{ quire_slot('header.nav') }}
                    </nav>
                {% endif %}
            {% endif %}
        </div>
    </header>
    {% endblock %}

    {#- An item's page prints the sidebar itself, after its text (content/single.html.twig) -#}
    {% set sidebar_here = quire_slot_filled('sidebar') and not (sidebar_in_content ?? false) %}
    <div class="qd-page{{ quire_slot_filled('sidebar') ? ' qd-has-sidebar' }}">
        <main id="content" tabindex="-1">
            {% block content %}{% endblock %}
        </main>
        {% if sidebar_here %}
            <aside class="qd-sidebar qd-container" aria-label="{{ 'Sidebar'|trans({}, domain) }}">{{ quire_slot('sidebar') }}</aside>
        {% endif %}
    </div>

    {% block footer %}
    <footer class="qd-site-footer">
        <p class="qd-print-source qd-container">{{ 'From {site} · {url}'|quire_trans({site: site.title, url: site.url}, domain) }}</p>
        <div class="qd-container qd-grid">
            <div class="qd-foot-brand">{{ identity.monogram(site.title) }}<div><b>{{ site.title }}</b>{% if site.description %}<p>{{ site.description }}</p>{% endif %}</div></div>
            {% if navigation|length > 0 %}
                <div><h2>{{ 'Pages'|quire_trans({}, domain) }}</h2><ul>{% for item in navigation %}<li><a href="{{ item.url }}">{{ item.title }}</a></li>{% endfor %}</ul></div>
            {% endif %}
            {% if not minimal %}
            <div class="qd-foot-site"><h2>{{ 'This site'|quire_trans({}, domain) }}</h2>
                {{ quire_slot('footer') }}
                {#- Signed in: the way out, as on the account page (pages aren't shared between visitors) -#}
                <ul><li>{% if app.user %}<a href="{{ logout_path() }}">{{ 'Sign out'|quire_trans({}, domain) }}</a>{% else %}<a href="{{ path('quire_login') }}">{{ 'Sign in'|quire_trans({}, domain) }}</a>{% endif %}</li></ul>
                {#- Said only when it's true: core reads the policy the site's pages are sent (enforced, every source the
                    site's own, nothing reported or hinted elsewhere) and every template of the theme -#}
                {% if (theme.settings.show_loads_nothing ?? true) and quire_loads_only_from_this_site() %}
                    <p class="qd-loads-nothing"><span class="qd-dot" aria-hidden="true"></span>{{ 'This site loads nothing from other companies.'|quire_trans({}, domain) }}</p>
                {% endif %}
            </div>
            {% endif %}
        </div>
        <div class="qd-container qd-base">
            {% block footer_base %}
            <p>© {{ 'now'|date('Y') }} {{ site.title }}</p>
            {% if theme.settings.show_credit ?? true %}<p class="qd-runs">{{ 'Runs on {quire}'|quire_trans_html({quire: identity.credit()}, domain) }}</p>{% endif %}
            {% endblock %}
        </div>
    </footer>
    {% endblock %}

    {{ quire_slot('body_end') }}
</body>
</html>
