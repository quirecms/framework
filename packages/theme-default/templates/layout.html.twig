{#
    The page around every page.

    Variables: site (title, description, url, locale, direction), theme (settings), canonical_url when
    the page has one, is_home on the homepage, and the variables of the page's own template.
    minimal: true on pages that must render when the site can't (the error page): no navigation, nothing
    read from the database.
    Blocks: title, head, ribbon (above the whole site, e.g. the preview notice), header (the masthead
    whole), brand (the link home in it: monogram, name, description), content, footer (the site's footer
    whole), footer_base (its last line: copyright and "Runs on Quire"). A child theme replaces one of them
    and keeps the rest; {{ parent() }} keeps the parent's part. Variables a block sets stay in it: what
    several share (navigation) is set before them.
    Slots: head, body_start, header.nav, sidebar, footer, body_end
#}
{% import 'partials/identity.html.twig' as identity %}
{% set minimal = minimal|default(false) %}
{% set domain = 'quire-theme-default' %}
<!doctype html>
<html lang="{{ app.request.locale|default(site.locale) }}" dir="{{ site.direction }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>{% block title %}{{ site.title }}{% endblock %}</title>
    {% if not minimal %}{{ quire_head() }}{% endif %}
    {# The fonts of the first screen: preloaded, and never swapped in mid-read (font-display: optional) #}
    {% for font in ['Newsreader-display-latin', 'Newsreader-text-latin', 'Inter-ui-latin'] %}
        <link rel="preload" href="{{ quire_asset('quire-theme-default/fonts/' ~ font ~ '.woff2') }}" as="font" type="font/woff2" crossorigin>
    {% endfor %}
    <link rel="icon" href="{{ quire_asset('quire-theme-default/favicon.svg') }}" type="image/svg+xml">
    {% block head %}{% endblock %}
    {{ quire_slot('head') }}
</head>
<body class="accent-{{ theme.settings.accent }}">
    <a class="skip-link" href="#content">{{ 'Skip to content'|trans({}, domain) }}</a>
    {% block ribbon %}{% endblock %}
    {{ quire_slot('body_start') }}
    {# Read once, for the header and the footer (a block's own variables don't reach the other) #}
    {% set navigation = minimal ? [] : quire_navigation() %}

    {% block header %}
    <header class="masthead">
        <div class="container masthead__main">
            {% block brand %}
            <a class="brand" href="{{ quire_home_url() }}"{% if is_home|default(false) %} aria-current="page"{% endif %} aria-label="{{ '{site}, home page'|trans({site: site.title}, domain) }}">
                {{ identity.monogram(site.title) }}
                <span><span class="brand__name">{{ site.title }}</span>{% if site.description %}<span class="brand__desc">{{ site.description }}</span>{% endif %}</span>
            </a>
            {% endblock %}
            {% if not minimal %}
                {% if quire_slot_filled('header.nav') or navigation|length > 0 %}
                    <nav class="site-nav" aria-label="{{ 'Main'|trans({}, domain) }}">
                        {% if navigation|length > 0 %}
                            {% set shown = navigation|length > 5 ? navigation|slice(0, 4) : navigation %}
                            <ul>{% for item in shown %}<li><a href="{{ item.url }}"{% if item.current %} aria-current="{{ item.current == 'page' ? 'page' : 'true' }}"{% endif %}>{{ item.title }}</a></li>{% endfor %}</ul>
                            {% if navigation|length > 5 %}
                                <details class="nav-more"><summary>{{ 'More'|trans({}, domain) }} <span aria-hidden="true">▾</span></summary>
                                    <ul>{% for item in navigation|slice(4) %}<li><a href="{{ item.url }}"{% if item.current %} aria-current="{{ item.current == 'page' ? 'page' : 'true' }}"{% endif %}>{{ item.title }}</a></li>{% endfor %}</ul>
                                </details>
                            {% endif %}
                        {% endif %}
                        {{ quire_slot('header.nav') }}
                    </nav>
                {% endif %}
            {% endif %}
        </div>
    </header>
    {% endblock %}

    <div class="page{{ quire_slot_filled('sidebar') ? ' has-sidebar' }}">
        <main id="content" tabindex="-1">
            {% block content %}{% endblock %}
        </main>
        {% if quire_slot_filled('sidebar') %}
            <aside class="sidebar container" aria-label="{{ 'Sidebar'|trans({}, domain) }}">{{ quire_slot('sidebar') }}</aside>
        {% endif %}
    </div>

    {% block footer %}
    <footer class="site-footer">
        <p class="print-source container">{{ 'From {site} · {url}'|trans({site: site.title, url: site.url}, domain) }}</p>
        <div class="container grid">
            <div class="foot-brand">{{ identity.monogram(site.title) }}<div><b>{{ site.title }}</b>{% if site.description %}<p>{{ site.description }}</p>{% endif %}</div></div>
            {% if navigation|length > 0 %}
                <div><h2>{{ 'Pages'|trans({}, domain) }}</h2><ul>{% for item in navigation %}<li><a href="{{ item.url }}">{{ item.title }}</a></li>{% endfor %}</ul></div>
            {% endif %}
            <div class="foot-site"><h2>{{ 'This site'|trans({}, domain) }}</h2>
                {{ quire_slot('footer') }}
                {% if not minimal %}<ul><li><a href="{{ path('quire_login') }}">{{ 'Sign in'|trans({}, domain) }}</a></li></ul>{% endif %}
            </div>
        </div>
        <div class="container base">
            {% block footer_base %}
            <p>© {{ 'now'|date('Y') }} {{ site.title }}</p>
            {% if theme.settings.show_credit ?? true %}<p class="runs">{{ 'Runs on {quire}'|quire_trans_html({quire: identity.credit()}, domain) }}</p>{% endif %}
            {% endblock %}
        </div>
    </footer>
    {% endblock %}

    {{ quire_slot('body_end') }}
</body>
</html>
