{#
    "Jump to a month": every month with posts, newest first, under its year. Each links to the heading of
    that month on the list page where it starts (its place in the list ÷ the page size), and the months
    shown on this page say so (aria-current, "on this page"): a month split across pages is on both.

    Variables: months (from content/list.html.twig: key "2026-11" → {start, page}), shown (the month keys
    on this page), type
#}
{% set domain = 'quire-theme-default' %}
{% if months|length > 1 %}
    <nav class="months" aria-labelledby="months-heading"><h2 id="months-heading">{{ 'Jump to a month'|trans({}, domain) }}</h2><ol>
        {%- set year = null -%}
        {%- for key, month in months -%}
            {%- set first = date(key ~ '-15') -%}
            {%- if first|date('Y') != year %}<li class="yr">{{ first|date('Y') }}</li>{% set year = first|date('Y') %}{% endif -%}
            {%- set here = key in shown -%}
            <li><a href="{{ quire_listing_url(type.id, month.page) }}#m-{{ key }}"{% if here %} aria-current="true"{% endif %} aria-label="{{ here ? '{month}, on this page'|trans({month: first|quire_date('month-year')}, domain) : first|quire_date('month-year') }}">{{ first|quire_date('month') }}</a></li>
        {%- endfor -%}
    </ol></nav>
{% endif %}
