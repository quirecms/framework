{#
    The account pages' card (v7: one calm card under a strip of the site's accent pattern), around the
    page's own content, core's "account" block: its form, fields and checks stay core's, the theme only
    frames them. The pattern comes from the site's name, as on the empty home.

    Variables: body (the page's account block, rendered)
#}
{% import 'partials/identity.html.twig' as identity %}
<div class="qd-container"><div class="qd-auth qd-auth--card">
    <div class="qd-auth__strip {{ identity.cover_classes('%04x'|format((site.title|length * 40503) % 65536)) }}" aria-hidden="true"></div>
    <div class="qd-auth__form">{{ body|raw }}</div>
</div></div>
