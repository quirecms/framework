{#
    The pager, one everywhere: Newer and Older, and the count; page numbers only past five pages (the
    first, the current one's neighbors, the last).

    Variables: page (page.page, page.pageCount), previous_url, next_url, type
#}
{% set domain = 'quire-theme-default' %}
{% if previous_url or next_url %}
    {% set numbers = page.pageCount > 5 %}
    <nav class="qd-pager{{ numbers ? ' qd-pager--numbers' }}" aria-label="{{ 'Pages'|trans({}, domain) }}">
        <span class="qd-newer">{% if previous_url %}<a href="{{ previous_url }}" rel="prev"><span class="qd-arrow" aria-hidden="true">←</span> {{ 'Newer'|quire_trans({}, domain) }}</a>{% endif %}</span>
        {% if numbers %}<div class="qd-pager__mid">{% endif %}
        <span class="qd-count">{{ 'Page {page} of {count}'|quire_trans({page: page.page, count: page.pageCount}, domain) }}</span>
        {% if numbers %}
            <ol class="qd-numbers">
                {%- set last = 0 -%}
                {#- Only the numbers shown, so a list of a thousand pages costs five links -#}
                {%- set wanted = [1, page.page - 1, page.page, page.page + 1, page.pageCount]|filter(n => n >= 1 and n <= page.pageCount)|reduce((carry, n) => n in carry ? carry : carry|merge([n]), []) -%}
                {%- for number in wanted -%}
                    {%- if last and number > last + 1 %}<li aria-hidden="true">…</li>{% endif -%}
                    <li><a href="{{ quire_listing_url(type.id, number) }}"{% if number == page.page %} aria-current="page"{% endif %} aria-label="{{ 'Page {page}'|trans({page: number}, domain) }}">{{ number }}</a></li>
                    {%- set last = number -%}
                {%- endfor -%}
            </ol>
            </div>
        {% endif %}
        <span class="qd-older">{% if next_url %}<a href="{{ next_url }}" rel="next">{{ 'Older'|quire_trans({}, domain) }} <span class="qd-arrow" aria-hidden="true">→</span></a>{% endif %}</span>
    </nav>
{% endif %}
