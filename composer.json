{
    "name": "quire/framework",
    "type": "project",
    "license": "MIT",
    "description": "Quire CMS development monorepo: the core, first-party extensions and the application they run in.",
    "homepage": "https://quirecms.com",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "versions": {
                    "quire/core": "0.1.x-dev",
                    "quire/testing": "0.1.x-dev",
                    "quire/theme-default": "0.1.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.5.11",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "quire/core": "0.1.x-dev",
        "quire/theme-default": "0.1.x-dev",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "8.1.*",
        "symfony/rate-limiter": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "Quire\\Fixtures\\Hello\\": "tests/Fixtures/extensions/hello/src/",
            "Quire\\Tests\\": "packages/core/tests/",
            "Quire\\Testing\\Tests\\": "packages/testing/tests/",
            "Quire\\ThemeDefault\\Tests\\": "packages/theme-default/tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer check --diff",
        "rector": "rector process --dry-run",
        "qa": [
            "@cs",
            "@rector",
            "@phpstan",
            "@test"
        ],
        "fix": [
            "rector process",
            "php-cs-fixer fix"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suites.",
        "phpstan": "Run PHPStan at level max.",
        "cs": "Check coding standards without changing files.",
        "rector": "Show automated refactorings without applying them.",
        "qa": "Run every quality check (the same ones CI runs).",
        "fix": "Apply Rector refactorings and coding-standard fixes."
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*",
            "docker": true
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "league/flysystem-async-aws-s3": "^3.29",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4",
        "quire/testing": "0.1.x-dev",
        "rector/rector": "^2.7",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*"
    }
}
